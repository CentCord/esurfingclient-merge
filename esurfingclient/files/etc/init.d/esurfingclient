#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/esurfingclient

LOG_DIR_DEFAULT=/var/log/esurfing/logs

get_log_dir() {
  local dir
  dir="$($PROG --print-log-dir 2>/dev/null)"
  [ -n "$dir" ] || dir="$LOG_DIR_DEFAULT"
  echo "$dir"
}

wait_network() {
  local i=0
  # 20 秒足够接口起来; 原来 60 秒会让"启动很慢"变成常态
  while [ $i -lt 20 ]; do
      ip route show default 2>/dev/null | grep -q "default" && return 0
      sleep 1
      i=$((i + 1))
  done
  return 1
}

# 临时调试模式到期后自动降回 INFO(4)
# 由 LuCI 的"临时调试"按钮写入 /tmp/esf_debug_until (epoch 秒)
revert_expired_debug_level() {
  local until now lv cfg
  cfg=/etc/config/esurfingclient
  [ -f /tmp/esf_debug_until ] || return 0
  until="$(cat /tmp/esf_debug_until 2>/dev/null)"
  case "$until" in ''|*[!0-9]*) rm -f /tmp/esf_debug_until; return 0 ;; esac
  now="$(date +%s)"
  [ "$now" -lt "$until" ] && return 0

  lv="$(sed -n 's/.*"log_lv"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$cfg" 2>/dev/null | head -n 1)"
  if [ "$lv" = "5" ] || [ "$lv" = "6" ]; then
      if sed -i 's/\("log_lv"[[:space:]]*:[[:space:]]*\)[0-9][0-9]*/\14/' "$cfg" 2>/dev/null; then
          echo "esurfingclient: 临时调试已到期, 日志级别恢复为 4"
      fi
  fi
  rm -f /tmp/esf_debug_until
}

archive_previous_log() {
  local log_dir log_file ts target n
  log_dir="$(get_log_dir)"
  log_file="$log_dir/run.log"

  [ -s "$log_file" ] || return 0

  ts="$(date +%Y%m%d-%H%M%S)"
  target="$log_dir/$ts.log"

  # 同一秒内重复启动也不能覆盖已有的归档
  n=1
  while [ -e "$target" ]; do
      target="$log_dir/$ts-$n.log"
      n=$((n + 1))
  done

  if mv "$log_file" "$target" 2>/dev/null; then
      echo "esurfingclient: 上一轮的日志已归档为 ${target##*/}"
  fi
}

boot() {
  # 不再固定 sleep 5: 接口就绪由 start_service 里的 wait_network 判断
  start
}

start_service() {
  if running_old_binary; then
      echo "esurfingclient: 旧服务仍在运行, 手动重启服务"
      ( "${initscript:-/etc/init.d/esurfingclient}" stop )
  fi

  if ! wait_network; then
      echo "esurfingclient: 等待网络服务超时"
      return 1
  fi

  # 临时调试到期就自动降级, 免得忘记关掉把 tmpfs 写满
  revert_expired_debug_level

  local accounts
  accounts="$($PROG --list-accounts 2>/dev/null)"

  if [ -z "$accounts" ]; then
      echo "esurfingclient: 没有可用账号, 或程序 enabled 参数未设置为启用, 未启动任何实例, 请检查配置文件"
      return 0
  fi

  local idx
  local count=0
  local flat=""
  for idx in $accounts; do
      procd_open_instance "account${idx}"
      procd_set_param command $PROG --role auth --account $idx
      procd_set_param respawn 60 5 5
      procd_set_param term_timeout 5
      procd_set_param stdout 1
      procd_set_param stderr 1
      procd_close_instance
      count=$((count + 1))
      flat="${flat}${flat:+ }${idx}"
  done

  echo "esurfingclient: 已启动 ${count} 个认证进程实例: ${flat}"
}

auth_pids() {
  local p cmd base
  base="${PROG##*/}"
  for p in /proc/[0-9]*; do
      [ -r "$p/cmdline" ] || continue
      cmd="$(tr '\0' ' ' 2>/dev/null < "$p/cmdline")"
      case "$cmd" in
          "$PROG "*|"$base "*) echo "${p#/proc/}" ;;
      esac
  done
}

running_old_binary() {
  local p exe
  for p in $(auth_pids); do
      exe="$(readlink "/proc/$p/exe" 2>/dev/null)"
      case "$exe" in
          *"(deleted)") return 0 ;;
      esac
  done
  return 1
}

service_stopped() {
  local i=0
  while [ $i -lt 5 ]; do
      [ -n "$(auth_pids)" ] || break
      sleep 1
      i=$((i + 1))
  done

  [ -n "$(auth_pids)" ] || archive_previous_log
}

reload_service() {
  stop
  start
}
